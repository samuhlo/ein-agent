{
  "name": "@ein/spike-opentui-solid-packaging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:candidate": "bun run scripts/build-candidate.ts",
    "check": "bun run typecheck && bun run test",
    "inventory": "bun run scripts/stage.ts",
    "test": "bun test --preload ../../node_modules/@opentui/solid/scripts/preload.js ./tests/*.case.ts ./tests/*.case.tsx",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run scripts/verify.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
