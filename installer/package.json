{
  "name": "ein-installer",
  "version": "0.73.0",
  "description": "Cross-platform installer for the Ein Pi Coding Agent workbench",
  "type": "module",
  "private": true,
  "author": "samuhlo",
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/main.ts",
    "bundle-template": "bun run scripts/bundle-template.ts",
    "build:all": "bun run scripts/build-all.ts",
    "typecheck": "tsc --noEmit",
    "bundle-template:host": "bun run scripts/bundle-template-host.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@opentui/solid": "0.5.1",
    "@types/bun": "^1.3.0",
    "typescript": "5.9.3"
  }
}
